@@ -0,0 +1,17 @@
+from tinydb import TinyDB, Query
+from tinydb.operations import append
+from tinydb.storages import MemoryStorage
+
+
+def test_append_to_list():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'id': 1, 'tags': ['a']})
+    db.update(append('tags', 'b'), Query().id == 1)
+    assert db.all()[0]['tags'] == ['a', 'b']
+
+
+def test_append_creates_field():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'id': 1})
+    db.update(append('tags', 'b'), Query().id == 1)
+    assert db.all()[0]['tags'] == ['b']
diff --git a/tinydb/operations.py b/tinydb/operations.py
index 3f6c6ab..be30945 100644
--- a/tinydb/operations.py
+++ b/tinydb/operations.py
@@ -73,3 +73,18 @@ def decrement(field: str) -> Callable[[MutableMapping], None]:
         doc[field] -= 1
 
     return transform
+
+
+def append(field: str, val: Any) -> Callable[[MutableMapping], None]:
+    """
+    Append ``val`` to a list field, creating the list if needed.
+    """
+    def transform(doc: MutableMapping):
+        if field not in doc:
+            doc[field] = [val]
+        elif isinstance(doc[field], list):
+            doc[field].append(val)
+        else:
+            doc[field] = [doc[field], val]
+
+    return transform
